# Backend environment variables - copy to .env and fill values (DO NOT COMMIT .env)

# Server
PORT=5000
NODE_ENV=development

# Database - for docker-compose use: postgres://postgres:password@db:5432/msss
# In production use a managed DB and a secure password
DATABASE_URL=postgres://postgres:password@db:5432/msss

# Or if your app reads individual DB vars, set these as alternatives
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=msss

# JWT secret
JWT_SECRET=replace_with_a_strong_secret

# Storage driver: local or s3
STORAGE_DRIVER=local

# (Optional) S3 settings if STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_KEY=
S3_SECRET=

# Frontend origin allowed for CORS
FRONTEND_ORIGIN=http://localhost:5173
